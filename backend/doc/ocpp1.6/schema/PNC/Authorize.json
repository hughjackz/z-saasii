{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "AuthorizeReq",
  "type": "object",
  "properties": {
    "certificate": {
      "type": "string",
      "maxLength": 5500,
      "description": "Optional. X.509 certificate presented by EV in PEM format."
    },
    "idToken": {
      "type": "object",
      "properties": {
        "idToken": { "type": "string", "maxLength": 20 }
      },
      "required": ["idToken"],
      "description": "Required. Contains the identifier that needs to be authorized."
    },
    "iso15118CertificateHashData": {
      "type": "array",
      "maxItems": 4,
      "items": {
        "type": "object",
        "properties": {
          "hashAlgorithm": { "type": "string", "enum": ["SHA256", "SHA384", "SHA512"] },
          "issuerNameHash": { "type": "string", "maxLength": 128 },
          "issuerKeyHash": { "type": "string", "maxLength": 128 },
          "serialNumber": { "type": "string", "maxLength": 40 },
          "responderURL": { "type": "string", "maxLength": 512 }
        },
        "required": ["hashAlgorithm", "issuerNameHash", "issuerKeyHash", "serialNumber", "responderURL"]
      },
      "description": "Optional. Info needed to verify the EV Contract Certificate via OCSP."
    }
  },
  "required": ["idToken"],
  "additionalProperties": false
}