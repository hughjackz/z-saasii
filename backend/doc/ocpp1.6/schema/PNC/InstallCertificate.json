{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "InstallCertificateReq",
  "type": "object",
  "properties": {
    "certificateType": {
      "type": "string",
      "enum": ["V2GRootCertificate", "MORootCertificate"],
      "description": "Required. Indicates the certificate type that is sent."
    },
    "certificate": {
      "type": "string",
      "maxLength": 5500,
      "description": "Required. A PEM encoded X.509 certificate."
    }
  },
  "required": ["certificateType", "certificate"],
  "additionalProperties": false
}