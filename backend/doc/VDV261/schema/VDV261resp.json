{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "VDV261.resp",
  "description": "VDV261 响应报文",
  "type": "object",
  "required": ["seq", "vin", "driveoff", "prec_dsrd", "prec_hvac", "ambienttemp"],
  "properties": {
    "seq": {
      "type": "integer",
      "description": "序号"
    },
    "vin": {
      "type": "string",
      "description": "VIN"
    },
    "driveoff": {
      "type": "integer",
      "minimum": 0,
      "maximum": 1440,
      "description": "预定出发时间"
    },
    "prec_dsrd": {
      "type": "integer",
      "enum": [0, 1],
      "description": "DMS预处理请求。0: no, 1: yes"
    },
    "prec_hvac": {
      "type": "integer",
      "enum": [0, 1, 2, 3],
      "description": "HVAC预处理请求。0: only hot water and ventilation, 1: hot water and heating, 2: no hot water, cooling or ventilation, 3: no preconditioning or SNA"
    },
    "ambienttemp": {
      "type": "integer",
      "minimum": -50,
      "maximum": 70,
      "description": "环境温度"
    }
  }
}